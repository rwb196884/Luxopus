import "date"

from(bucket: "solar")
  |> range(start: -10y, stop: today())
  |> filter(fn: (r) => true
    and date.month(t: r["_time"]) == date.month(t: today())
    and r["_measurement"] == "daily" 
    and r["_field"] == "generation"
  )
  |> filter(fn: (r) => r["_time"] < 2026-07-22T00:00:00Z or r["_time"] > 2026-10-04T00:00:00Z) // Squirrels.
  |> group(columns: [])
  |> median()