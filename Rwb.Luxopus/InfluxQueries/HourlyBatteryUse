import "date"

from(bucket: "solar")
  |> range(start: -3mo, stop: today())
  |> filter(fn: (r) => r["_measurement"] == "inverter" and r["_field"] == "consumption")
  |> map(fn: (r) => ({
    h: date.hour(t: r._time),
    d: date.weekDay(t: r._time),
    _value: r._value
  })
  )
  |> filter(fn: (r) => exists r._value)
  |> group(columns: ["d", "h"])
  |> quantile(q: 0.75)
  |> group(columns: [])